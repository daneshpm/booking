# Long-running workflow worker.
#
# Sends reminders and follow-ups on a loop. Safe to run several replicas and
# alongside the scheduled CI job: every delivery is claimed through a unique
# index, so nothing is sent twice.

# ---------------------------------------------------------------
FROM node:26-alpine AS deps
WORKDIR /repo

# Manifests first, so this layer is reused when only source changes.
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/auth/package.json packages/auth/
COPY packages/core/package.json packages/core/
COPY packages/database/package.json packages/database/
COPY packages/notifications/package.json packages/notifications/
COPY packages/ui/package.json packages/ui/
COPY packages/features/services/package.json packages/features/services/

RUN npm ci

# ---------------------------------------------------------------
FROM node:26-alpine AS builder
WORKDIR /repo

COPY --from=deps /repo/node_modules ./node_modules
COPY package.json ./
COPY packages ./packages

RUN npx prisma generate --schema packages/database/prisma/schema.prisma

# ---------------------------------------------------------------
FROM node:26-alpine AS runner
WORKDIR /repo

ENV NODE_ENV=production

# Run as an unprivileged user rather than root. Created before the copies
# below so each can be chowned directly instead of a separate recursive
# chown over the whole tree, which is slow and, with an overlay filesystem
# backing the container runtime, can exhaust available space entirely.
RUN addgroup --system --gid 1001 worker \
  && adduser --system --uid 1001 worker

# Development dependencies are kept deliberately: the worker's entry point is
# TypeScript run through tsx, and the Prisma client is generated by the CLI.
# Pruning them produces a smaller image that cannot start.
COPY --from=builder --chown=worker:worker /repo/node_modules ./node_modules
COPY --from=builder --chown=worker:worker /repo/package.json ./package.json
COPY --from=builder --chown=worker:worker /repo/packages ./packages

USER worker

CMD ["npm", "run", "workflows:worker"]
