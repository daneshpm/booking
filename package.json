{
  "name": "apex-bookings",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.14.1",
  "description": "Enterprise-grade multi-tenant appointment scheduling platform inspired by modern scheduling architecture",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/features/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "npm --workspace=@bookings/database run generate",
    "db:push": "npm --workspace=@bookings/database run push",
    "db:migrate": "npm --workspace=@bookings/database run migrate:dev",
    "db:migrate:deploy": "npm --workspace=@bookings/database run migrate:deploy",
    "db:seed": "npm --workspace=@bookings/database run seed",
    "typecheck": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "sessions:purge": "npm --workspace=@bookings/database run purge:sessions",
    "audit": "node scripts/audit.mjs",
    "workflows:run": "npm --workspace=@bookings/notifications run workflows:run",
    "workflows:worker": "npm --workspace=@bookings/notifications run workflows:worker"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.5.3",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
