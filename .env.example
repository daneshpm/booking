# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
# The application and the FastAPI service share this database.
DATABASE_URL="postgresql://postgres:password123@localhost:5434/bookings_dev?schema=public"

# Scratch database used when replaying migrations, which only `npm run
# db:migrate` and the CI drift check need. Prisma drops and recreates whatever
# this points at, so it must never be the database above. Leave it unset and
# Prisma creates a temporary one itself.
SHADOW_DATABASE_URL=""

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Workspace slug the marketing landing page links to. Leave unset and the
# landing page links to the public booking directory instead.
NEXT_PUBLIC_DEFAULT_WORKSPACE_SLUG=""

# ---------------------------------------------------------------
# Seed credentials (used only by `npm run db:seed`)
# ---------------------------------------------------------------
# The seed refuses to run without these and will not invent a password.
# ADMIN_PASSWORD must be at least 10 characters with upper case, lower case
# and a digit.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Workspace Owner"
WORKSPACE_NAME="Rooman Technologies"
WORKSPACE_SLUG="rooman-technologies"
WORKSPACE_TIMEZONE="Asia/Kolkata"
WORKSPACE_CURRENCY="INR"

# ---------------------------------------------------------------
# Email delivery
# ---------------------------------------------------------------
# Leave SMTP_HOST empty to disable sending. Notifications are still recorded
# so nothing is lost, and the dashboard shows that delivery is unconfigured.
# Locally, Mailpit from docker/docker-compose.yml listens on port 1025.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Rooman Bookings <noreply@rooman.local>"

# ---------------------------------------------------------------
# SMS delivery (optional)
# ---------------------------------------------------------------
# SMS goes out over the SMTP settings above, through an email-to-SMS gateway:
# the number becomes an address at this domain and the mail server relays it.
# No separate provider account is needed.
#
# Use your SMS provider's gateway domain, or a carrier's if you know the
# recipient's network. Leave unset to disable SMS: workflows using that channel
# still record every attempt and the dashboard says it is off.
#
# Recipients need an international number (+91...) on file to receive one.
# Note a gateway gives no delivery receipt, so an accepted message may still
# not arrive.
SMS_GATEWAY_DOMAIN=""

# Set to a country code, without the plus, for a gateway that expects a
# national number. Leave empty to send the full international digits.
SMS_GATEWAY_STRIP_COUNTRY_CODE=""

# Most gateways prepend the subject to the message, so it is empty by default.
SMS_GATEWAY_SUBJECT=""

# ---------------------------------------------------------------
# Webhook delivery (optional)
# ---------------------------------------------------------------
# Signs every webhook with HMAC-SHA256 so receivers can prove the request came
# from you. Without it webhooks are sent unsigned and anyone who learns the URL
# can forge events, so set this in production.
WEBHOOK_SIGNING_SECRET=""
# Allows http:// webhook targets. Development only: it disables the transport
# check that stops payloads being sent in the clear.
WEBHOOK_ALLOW_INSECURE="false"

# ---------------------------------------------------------------
# Workflow worker
# ---------------------------------------------------------------
# Seconds between sweeps for due reminders and follow-ups.
WORKFLOW_INTERVAL_SECONDS="60"

# ---------------------------------------------------------------
# Video meetings
# ---------------------------------------------------------------
# Base URL for generated meeting rooms. The default public Jitsi service
# creates a room the moment someone opens the link, so no API key is needed.
# Point this at a self-hosted instance for production.
VIDEO_MEETING_BASE_URL="https://meet.jit.si"
VIDEO_MEETING_ROOM_PREFIX="rooman"

# ---------------------------------------------------------------
# FastAPI service (apps/api)
# ---------------------------------------------------------------
# Where the Next.js app proxies /api/py/* requests.
PYTHON_API_URL="http://127.0.0.1:8000"
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------
# Redis
# ---------------------------------------------------------------
# Shares rate-limit counters across instances. Without it each instance counts
# on its own, which is fine for a single-container deployment but means the
# limit multiplies by the number of instances behind a load balancer.
REDIS_URL="redis://localhost:6379"
