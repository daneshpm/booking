datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  STAFF
  RECEPTIONIST
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum LocationType {
  ONLINE_MEETING
  IN_PERSON_BUSINESS
  IN_PERSON_CUSTOMER
  PHONE_CALL
}

enum WorkflowTrigger {
  BOOKING_CREATED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BEFORE_APPOINTMENT
  AFTER_APPOINTMENT
}

enum WorkflowChannel {
  EMAIL
  SMS
  WEBHOOK
}

enum WorkflowRecipient {
  CUSTOMER
  STAFF
  BOTH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Distinguishes a bookable physical resource (a room, a piece of equipment)
/// from a person. A resource is scheduled through the exact same machinery as
/// a person: working hours, overrides and the exclusion constraint that
/// guarantees no double-booking all apply unchanged, since a room can no more
/// be in two meetings at once than a person can.
enum StaffKind {
  PERSON
  RESOURCE
}

// ----------------------------------------------------
// AUTH & TENANCY
// ----------------------------------------------------

model User {
  id              String               @id @default(uuid())
  email           String               @unique
  name            String
  displayName     String?              @map("display_name")
  passwordHash    String
  avatarUrl       String?
  phone           String?
  gender          String?              @default("I'd prefer not to say")
  country         String?              @default("India")
  state           String?              @default("Karnataka")
  language        String?              @default("English")
  timezone        String?              @default("Asia/Kolkata")
  bio             String?
  headline        String?
  instagram       String?
  linkedin        String?
  twitter         String?
  website         String?
  isActive        Boolean              @default(true) @map("is_active")
  lastLoginAt     DateTime?            @map("last_login_at") @db.Timestamptz
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  memberships     WorkspaceMember[]
  staffProfiles   Staff[]
  sessions        Session[]
  resetTokens     PasswordResetToken[]
  sentInvitations Invitation[]

  @@map("users")
}

/// Server-side sessions. Only a SHA-256 hash of the opaque token is stored, so a
/// database leak cannot be replayed against the application.
model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use password reset token. Only the SHA-256 digest is stored, so a
/// database leak cannot be used to take over accounts.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// A pending teammate invitation. Only the SHA-256 digest of the link's token
/// is stored, same reasoning as PasswordResetToken. Not scoped to an existing
/// User: the invitee may not have an account yet, in which case one is
/// created only once the invitation is actually accepted.
model Invitation {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  email       String
  /// OWNER is granted separately (see updateMemberRoleAction), not through an
  /// invitation: it is rare enough, and consequential enough, to deserve its
  /// own explicit action rather than being one option among several here.
  role        Role      @default(STAFF)
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([tokenHash])
  @@map("invitations")
}

model Workspace {
  id                    String   @id @default(uuid())
  name                  String
  slug                  String   @unique
  logoUrl               String?
  timezone              String   @default("UTC")
  currency              String   @default("USD")
  /// Hex color, e.g. "#5c34ad". Null uses the default indigo theme.
  brandColor            String?  @map("brand_color")
  bookingWelcomeTitle   String?  @map("booking_welcome_title")
  bookingWelcomeMessage String?  @map("booking_welcome_message")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  members           WorkspaceMember[]
  staff             Staff[]
  services          Service[]
  serviceCategories ServiceCategory[]
  customers         Customer[]
  bookings          Booking[]
  bookingPages      BookingPage[]
  workflows         Workflow[]
  notifications     NotificationLog[]
  waitlistEntries   WaitlistEntry[]
  routingForm       RoutingForm?
  invitations       Invitation[]

  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        Role     @default(STAFF)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ----------------------------------------------------
// STAFF & AVAILABILITY
// ----------------------------------------------------

model Staff {
  id          String    @id @default(uuid())
  workspaceId String    @map("workspace_id")
  userId      String?   @map("user_id")
  kind        StaffKind @default(PERSON)
  name        String
  displayName String?   @map("display_name")
  email       String
  phone       String?
  avatarUrl   String?
  bio         String?
  headline    String?
  instagram   String?
  linkedin    String?
  timezone    String    @default("UTC")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                  User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceAssignments    ServiceStaff[]
  workingHours          StaffWorkingHours[]
  availabilityOverrides StaffOverride[]
  calendarConnections   CalendarConnection[]
  bookings              Booking[]
  waitlistEntries       WaitlistEntry[]
  participatingBookings BookingParticipant[]

  @@unique([workspaceId, email])
  @@index([workspaceId, isActive])
  @@map("staff")
}

model StaffWorkingHours {
  id        String       @id @default(uuid())
  staffId   String       @map("staff_id")
  dayOfWeek Int          @map("day_of_week") // 0 = Sun, 1 = Mon ... 6 = Sat
  startTime String       @map("start_time") // "09:00"
  endTime   String       @map("end_time") // "17:00"
  breaks    StaffBreak[]

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@map("staff_working_hours")
}

model StaffBreak {
  id                  String @id @default(uuid())
  staffWorkingHoursId String @map("staff_working_hours_id")
  startTime           String @map("start_time") // "13:00"
  endTime             String @map("end_time") // "14:00"

  workingHours StaffWorkingHours @relation(fields: [staffWorkingHoursId], references: [id], onDelete: Cascade)

  @@map("staff_breaks")
}

model StaffOverride {
  id        String   @id @default(uuid())
  staffId   String   @map("staff_id")
  date      DateTime @db.Date // e.g. 2026-12-25
  isWorking Boolean  @default(false) @map("is_working") // false = Holiday/Leave, true = Special shift
  startTime String?  @map("start_time") // "10:00"
  endTime   String?  @map("end_time") // "14:00"

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@map("staff_overrides")
}

// ----------------------------------------------------
// SERVICES & CATALOG
// ----------------------------------------------------

model ServiceCategory {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  services  Service[]

  @@unique([workspaceId, name])
  @@map("service_categories")
}

model Service {
  id                  String       @id @default(uuid())
  workspaceId         String       @map("workspace_id")
  categoryId          String?      @map("category_id")
  name                String
  slug                String
  description         String?
  durationMinutes     Int          @default(30) @map("duration_minutes")
  bufferBeforeMinutes Int          @default(0) @map("buffer_before_minutes")
  bufferAfterMinutes  Int          @default(0) @map("buffer_after_minutes")
  price               Decimal      @default(0.00) @db.Decimal(10, 2)
  currency            String       @default("USD")
  locationType        LocationType @default(ONLINE_MEETING) @map("location_type")
  locationDetails     String?      @map("location_details")
  isActive            Boolean      @default(true) @map("is_active")

  // Dynamic Off-Peak Yield Pricing ("Happy Hours")
  hasYieldPricing      Boolean @default(false) @map("has_yield_pricing")
  yieldDiscountPercent Int?    @default(0) @map("yield_discount_percent") // e.g. 15 for 15% off
  yieldDays            String? @map("yield_days") // e.g. "1,2,3,4" (Monday through Thursday)
  yieldStartTime       String? @map("yield_start_time") // e.g. "11:00"
  yieldEndTime         String? @map("yield_end_time") // e.g. "15:00"
  yieldLabel           String? @default("Off-Peak Special") @map("yield_label")

  // Intake Form, Add-ons & Team Routing Configuration
  intakeQuestions Json?   @map("intake_questions")
  addons          Json?   @map("addons")
  /// "ANY_AVAILABLE" (default): the first assigned staff member free at a
  /// time is booked. "ROUND_ROBIN": whichever assigned staff member has the
  /// fewest confirmed bookings. "ALL_REQUIRED": a collective/panel booking —
  /// every assigned staff member must be free at once, and all of them are
  /// booked together (see BookingParticipant).
  routingStrategy String? @default("ANY_AVAILABLE") @map("routing_strategy")
  /// Null or 1 means a normal one-on-one service. Above 1, up to this many
  /// customers can book the same staff member's same time slot (a class or
  /// workshop) instead of each booking exclusively blocking it.
  capacity        Int?    @map("capacity")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category           ServiceCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staffAssignments   ServiceStaff[]
  bookings           Booking[]
  waitlistEntries    WaitlistEntry[]
  workflows          Workflow[]
  routingFormOptions RoutingFormOption[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, isActive])
  @@map("services")
}

model ServiceStaff {
  id               String   @id @default(uuid())
  serviceId        String   @map("service_id")
  staffId          String   @map("staff_id")
  priceOverride    Decimal? @map("price_override") @db.Decimal(10, 2)
  durationOverride Int?     @map("duration_override")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([serviceId, staffId])
  @@map("service_staff")
}

// ----------------------------------------------------
// CUSTOMERS & BOOKING ENGINE
// ----------------------------------------------------

model Customer {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String
  email       String
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@unique([workspaceId, email])
  @@index([workspaceId, name])
  @@map("customers")
}

model Booking {
  id                   String        @id @default(uuid())
  workspaceId          String        @map("workspace_id")
  serviceId            String        @map("service_id")
  staffId              String        @map("staff_id")
  customerId           String        @map("customer_id")
  startTime            DateTime      @map("start_time") @db.Timestamptz
  endTime              DateTime      @map("end_time") @db.Timestamptz
  customerTimezone     String        @default("UTC") @map("customer_timezone")
  status               BookingStatus @default(CONFIRMED)
  /// True when this booking is one of several sharing the same staff member
  /// and time slot (Service.capacity > 1). Denormalized from the service at
  /// creation time so bookings_no_staff_overlap's WHERE clause, which can
  /// only reference this table's own columns, can exempt these rows: several
  /// customers legitimately share one slot in a group service, which is
  /// exactly what that constraint otherwise exists to prevent.
  isGroupBooking       Boolean       @default(false) @map("is_group_booking")
  source               String?       @default("ONLINE") // ONLINE, WALK_IN, PHONE_CALL
  paidPrice            Decimal?      @map("paid_price") @db.Decimal(10, 2)
  discountApplied      Int?          @default(0) @map("discount_applied")
  discountLabel        String?       @map("discount_label")
  paymentStatus        PaymentStatus @default(PAID) @map("payment_status")
  paymentProvider      String?       @map("payment_provider") // RAZORPAY, STRIPE, MOCK, FREE
  paymentOrderId       String?       @map("payment_order_id")
  paymentTransactionId String?       @map("payment_transaction_id")
  paymentCurrency      String?       @map("payment_currency")
  paidAt               DateTime?     @map("paid_at") @db.Timestamptz
  intakeResponses      Json?         @map("intake_responses")
  selectedAddons       Json?         @map("selected_addons")
  manageToken          String?       @unique @map("manage_token")
  cancellationReason   String?       @map("cancellation_reason")
  rescheduledFromId    String?       @unique @map("rescheduled_from_id")
  meetingLink          String?       @map("meeting_link")
  idempotencyKey       String?       @map("idempotency_key")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service         Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff           Staff                @relation(fields: [staffId], references: [id], onDelete: Restrict)
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  rescheduledFrom Booking?             @relation("RescheduleHistory", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Booking?             @relation("RescheduleHistory")
  auditLogs       BookingAuditLog[]
  notifications   NotificationLog[]
  participants    BookingParticipant[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status])
  @@index([staffId, startTime, endTime])
  @@index([customerId])
  @@index([workspaceId, source])
  @@index([manageToken])
  @@map("bookings")
}

/// The staff required by a "collective" booking (routingStrategy
/// ALL_REQUIRED) beyond the primary Booking.staffId, e.g. every panelist in
/// a panel interview. Times are denormalized from the parent booking (kept
/// in sync on reschedule/cancel) so this table can carry its own exclusion
/// constraint, the same mechanism that guarantees no double-booking on
/// `bookings` itself, scoped to these additional participants.
///
/// This does not by itself stop the *primary* staff member of one booking
/// from being double-booked as a *participant* of a different one: that
/// would need a single constraint spanning both tables, which Postgres
/// cannot express. createPublicBookingAction re-checks every required staff
/// member's schedule (including this table, via loadSchedules) immediately
/// before writing and refuses the booking if any of them is no longer free,
/// but that check and the write are not atomic, so a concurrent request
/// landing in between is a real, currently-accepted race — the same
/// TOCTOU window every availability check in this codebase has before its
/// insert, narrowed by the pre-write re-check but not closed by it.
model BookingParticipant {
  id        String        @id @default(uuid())
  bookingId String        @map("booking_id")
  staffId   String        @map("staff_id")
  startTime DateTime      @map("start_time") @db.Timestamptz
  endTime   DateTime      @map("end_time") @db.Timestamptz
  status    BookingStatus @default(CONFIRMED)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([bookingId, staffId])
  @@index([staffId, startTime, endTime])
  @@map("booking_participants")
}

model BookingAuditLog {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  action    String   @map("action") // CREATED, CANCELLED, RESCHEDULED, STATUS_CHANGE
  actorType String   @map("actor_type") // CUSTOMER, STAFF, SYSTEM
  actorId   String?  @map("actor_id")
  details   Json?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_audit_logs")
}

// ----------------------------------------------------
// PUBLIC BOOKING PAGES & CALENDARS
// ----------------------------------------------------

model BookingPage {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  slug        String
  title       String
  description String?
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@map("booking_pages")
}

/// A single-question pre-booking form that routes a customer straight to the
/// matching service instead of showing the full catalogue. One per workspace:
/// letting a customer answer two conflicting routing forms on the same public
/// page would be confusing without adding real value.
model RoutingForm {
  id          String   @id @default(uuid())
  workspaceId String   @unique @map("workspace_id")
  question    String
  isEnabled   Boolean  @default(false) @map("is_enabled")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  options   RoutingFormOption[]

  @@map("routing_forms")
}

model RoutingFormOption {
  id            String @id @default(uuid())
  routingFormId String @map("routing_form_id")
  serviceId     String @map("service_id")
  label         String
  sortOrder     Int    @default(0) @map("sort_order")

  routingForm RoutingForm @relation(fields: [routingFormId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([routingFormId])
  @@map("routing_form_options")
}

model CalendarConnection {
  id           String   @id @default(uuid())
  staffId      String   @map("staff_id")
  provider     String // GOOGLE, OUTLOOK, APPLE
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  calendarId   String   @map("calendar_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, provider, calendarId])
  @@map("calendar_connections")
}

// ----------------------------------------------------
// AUTOMATION & NOTIFICATIONS
// ----------------------------------------------------

/// A configurable automation rule. Evaluated when a booking lifecycle event
/// fires, or on a time offset relative to the appointment start.
model Workflow {
  id            String            @id @default(uuid())
  workspaceId   String            @map("workspace_id")
  /// Restricts the workflow to one service's bookings. Null applies it to
  /// every service in the workspace, which is also what a deleted service
  /// falls back to rather than taking the whole workflow down with it.
  serviceId     String?           @map("service_id")
  name          String
  description   String?
  trigger       WorkflowTrigger
  channel       WorkflowChannel   @default(EMAIL)
  recipient     WorkflowRecipient @default(CUSTOMER)
  /// Minutes relative to the appointment start for time-based triggers.
  /// Negative runs before the appointment, positive after. Ignored otherwise.
  offsetMinutes Int               @default(0) @map("offset_minutes")
  subject       String?
  body          String?
  webhookUrl    String?           @map("webhook_url")
  isActive      Boolean           @default(true) @map("is_active")
  lastRunAt     DateTime?         @map("last_run_at")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  notifications NotificationLog[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isActive])
  @@index([serviceId])
  @@map("workflows")
}

/// Delivery record for every outbound notification, so operators can audit what
/// was sent and retry what failed.
model NotificationLog {
  id          String             @id @default(uuid())
  workspaceId String             @map("workspace_id")
  bookingId   String?            @map("booking_id")
  workflowId  String?            @map("workflow_id")
  channel     WorkflowChannel    @default(EMAIL)
  recipient   String
  subject     String?
  status      NotificationStatus @default(PENDING)
  error       String?
  attempts    Int                @default(0)
  sentAt      DateTime?          @map("sent_at")
  createdAt   DateTime           @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  workflow  Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)

  @@unique([workflowId, bookingId, recipient])
  @@index([workspaceId, status])
  @@index([bookingId])
  @@index([status, createdAt])
  @@map("notification_logs")
}

// ----------------------------------------------------
// SMART WAITLIST & CANCELLATION RECOVERY
// ----------------------------------------------------

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CLAIMED
  EXPIRED
  CANCELLED
}

model WaitlistEntry {
  id               String         @id @default(uuid())
  workspaceId      String         @map("workspace_id")
  serviceId        String         @map("service_id")
  staffId          String?        @map("staff_id")
  customerName     String         @map("customer_name")
  customerEmail    String         @map("customer_email")
  customerPhone    String?        @map("customer_phone")
  preferredDate    DateTime       @map("preferred_date") @db.Date
  notes            String?
  status           WaitlistStatus @default(WAITING)
  claimToken       String?        @unique @map("claim_token")
  notifiedAt       DateTime?      @map("notified_at") @db.Timestamptz
  claimedBookingId String?        @map("claimed_booking_id")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([workspaceId, serviceId, preferredDate, status])
  @@index([claimToken])
  @@map("waitlist_entries")
}
